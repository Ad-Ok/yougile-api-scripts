# Yougile API Configuration
#
# REQUIRED: API-ключ. Получите его в UI YouGile (Настройки → API)
# и впишите сюда. Этого достаточно для работы всех скриптов кроме auth.py.
YOUGILE_API_KEY=

# OPTIONAL: логин/пароль нужны ТОЛЬКО для auth.py (одноразовая
# автогенерация YOUGILE_API_KEY и YOUGILE_COMPANY_ID). Если ключ уже
# получен другим способом — эти поля можно оставить пустыми / удалить.
YOUGILE_LOGIN=
YOUGILE_PASSWORD=
YOUGILE_COMPANY_ID=

# Current working context (optional, задаётся через `python context.py setup`)
YOUGILE_CURRENT_PROJECT_ID=
YOUGILE_CURRENT_BOARD_ID=
